# GridWeave runtime settings. Copy to .env (never commit .env).
# All values are optional; defaults live in src/gridweave/config/settings.py.

# Path to the campus configuration JSON
GRIDWEAVE_CONFIG=configs/campus_default.json

# Master random seed for demand generation (reproducible runs)
GRIDWEAVE_SEED=42

# Logging level: DEBUG, INFO, WARNING, ERROR
GRIDWEAVE_LOG_LEVEL=INFO
